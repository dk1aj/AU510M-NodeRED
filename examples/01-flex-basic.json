    {
        "id": "7eecc2f78f6c47b0",
        "type": "function",
        "z": "c9a17f4601bc4e88",
        "name": "Identify frequency, mode, RX/TX",
        "func": "const topic = String(msg.topic || \"\");\nconst payload = msg.payload && typeof msg.payload === \"object\" ? msg.payload : {};\nconst found = [];\nconst slice = topic.match(/^slice\\/(\\d+)$/);\n\nif (slice && Object.prototype.hasOwnProperty.call(payload, \"RF_frequency\")) {\n    found.push({ topic: \"test/flex/frequency\", payload: { slice: slice[1], MHz: payload.RF_frequency } });\n}\nif (slice && typeof payload.mode === \"string\") {\n    found.push({ topic: \"test/flex/mode\", payload: { slice: slice[1], mode: payload.mode } });\n}\nif (topic === \"interlock\" && typeof payload.state === \"string\") {\n    const state = payload.state.toUpperCase();\n    const rxTx = state === \"TRANSMITTING\" ? \"TX\" : (state === \"RECEIVE\" || state === \"READY\" ? \"RX\" : \"UNKNOWN\");\n    found.push({ topic: \"test/flex/rx-tx\", payload: { rxTx, state } });\n}\n\nreturn found.length ? [found] : null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
